{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": [],
    "lib": ["esnext", "dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "react-native": ["./node_modules/react-native-macos"],
      "react-native/*": ["./node_modules/react-native-macos/*"],
      "@music-library/core": ["../core/src/index.ts"],
      "@music-library/core/api": ["../core/src/api.ts"],
      "@music-library/core/storage": ["../core/src/storage.ts"],
      "@music-library/core/events": ["../core/src/events.ts"],
      "@music-library/core/format": ["../core/src/format.ts"],
      "@music-library/core/auth": ["../core/src/auth/auth-core.tsx"],
      "@music-library/core/favorites": ["../core/src/favorites/favorites-core.tsx"],
      "@music-library/core/player": ["../core/src/player/index.ts"],
      "@music-library/core/player/*": ["../core/src/player/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/**/*.d.ts"],
  "exclude": ["node_modules", "packages", "macos"]
}
