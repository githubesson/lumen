{
  "fonts": ["Geist", "Geist Mono"],
  "fontSizes": [11, 12, 13, 14, 16, 18, 20, 24, 30, 36, 48, 60, 72],
  "typeRules": [
    { "selector": "h1", "sizes": [48, 60, 72] },
    { "selector": "h2", "sizes": [30, 36, 48] },
    { "selector": "h3", "sizes": [14, 16, 18] },
    { "selector": "button, [role=button]", "sizes": [12, 13, 14, 16] }
  ],
  "minControlSize": 15,
  "controlSizeRules": [],
  "minControlGap": 8,
  "minControlInset": 8,
  "controlContainers": ["[data-ui-container]"],
  "minLayoutGap": 8,
  "bannedCopy": ["unlock your potential", "seamlessly", "game-changing"],
  "viewports": [{ "width": 390, "height": 844 }, { "width": 1440, "height": 900 }],
  "colorSchemes": ["light", "dark"],
  "exceptions": [
    {
      "selector": "svg[role=img] text",
      "rules": ["font-family", "font-size", "text-contrast"],
      "reason": "Text drawn inside an SVG illustration: the self-host diagram and the MacBook's macOS menu bar. It is sized in viewBox units and axe cannot measure its background. Pixel sampling measured the diagram labels at 5.1:1 or more."
    },
    {
      "selector": ".truncate, .truncate *",
      "rules": ["content-clipping"],
      "reason": "Titles, artists and paths in the demos truncate to one line with an ellipsis on purpose, as in the app's track lists."
    }
  ]
}
