{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site on Workers: no Worker script, just the Vite build output.
  "name": "lumen-landing",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Custom domains create the DNS records and certificates themselves; the
  // lumen.rocks zone has to be on the same Cloudflare account.
  "routes": [
    { "pattern": "lumen.rocks", "custom_domain": true },
    { "pattern": "www.lumen.rocks", "custom_domain": true }
  ]
}
