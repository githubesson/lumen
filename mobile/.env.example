# Optional crash reporting. Empty means no Sentry SDK initialization or reports.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
# Also opt in to reports from development builds (normally disabled).
EXPO_PUBLIC_SENTRY_DEBUG=0

# Build/OTA uploads are separately opt-in. Set these in the EAS build environment
# and the publishing shell (or run the publisher through eas env:exec).
# SENTRY_UPLOAD_SOURCEMAPS=1
# SENTRY_ORG=your-organization
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=keep-this-in-your-secret-store
